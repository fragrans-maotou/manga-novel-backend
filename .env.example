# Copy to .env and adjust. Never commit real secrets.
# docker compose automatically loads .env for variable substitution.

POSTGRES_USER=manga
POSTGRES_PASSWORD=manga
POSTGRES_DB=manga
POSTGRES_PORT=5432

REDIS_PORT=6379

GATEWAY_HTTP_PORT=8080
HTTP_ADDR=:8080

# Injected into gateway-go (pgx + go-redis)
DATABASE_URL=postgres://manga:manga@postgres:5432/manga?sslmode=disable
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
STREAM_BLPOP_TIMEOUT=30s
CHAPTER_CACHE_TTL=86400
SCRAPE_TIMEOUT_MS=8000
SHUTDOWN_TIMEOUT=15s
PROXY_HTTP_TIMEOUT=30s

# Injected into scraper-py
REDIS_URL=redis://redis:6379/0
REDIS_BRPOP_TIMEOUT=5
WORKER_CONCURRENCY=4
FETCHER_IMPERSONATE=chrome124
LOG_LEVEL=INFO

# Resource hints (compose mem_limit)
GATEWAY_MEM_LIMIT=512m
SCRAPER_MEM_LIMIT=512m
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=256m
